{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrData",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "changes", "test_plan"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
