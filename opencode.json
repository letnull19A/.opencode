{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "evol-plan": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "react-architect": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "plan": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "primary"
    },
    "router": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    },
    "build-fast": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "build-smart": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "task-manager": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    },
    "worktree-manager": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    },
    "task-batch": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "task-explain": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "tunnel-manager": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "recon": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "react-concept": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "react-implement": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "subagent",
      "hidden": true
    },
    "ci": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    },
    "ask": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    },
    "diagnostics": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "mode": "all"
    }
  },
  "mcp": {
    "trello": {
      "type": "local",
      "command": ["npx", "-y", "@delorenj/mcp-server-trello"],
      "environment": {
        "TRELLO_API_KEY": "{env:TRELLO_API_KEY}",
        "TRELLO_TOKEN": "{env:TRELLO_TOKEN}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "dokploy": {
      "type": "local",
      "command": ["npx", "-y", "@dokploy/mcp"],
      "environment": {
        "DOKPLOY_URL": "{env:DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}",
        "DOKPLOY_TOOL_PRESET": "all"
      },
      "enabled": true
    },
    "speka": {
      "type": "remote",
      "url": "https://mcp.speka.click/mcp",
      "headers": {
        "Authorization": "Bearer {env:SPEKA_MCP_API_KEY}"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "mcp-postgres", "{env:DATABASE_URL}"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}",
        "POSTGRES_HOST": "{env:POSTGRES_HOST}",
        "POSTGRES_PORT": "{env:POSTGRES_PORT}",
        "POSTGRES_USER": "{env:POSTGRES_USER}",
        "POSTGRES_PASSWORD": "{env:POSTGRES_PASSWORD}"
      },
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "bash .opencode/scripts/tunnel/run.sh*": "allow",
      "bash .opencode/scripts/push/run.sh*": "allow",
      "bash .opencode/scripts/sync/run.sh*": "allow",
      "bash .opencode/scripts/react-fix/*": "allow",
      "bash .opencode/scripts/task-manager/*": "allow",
      "bash .opencode/scripts/commit-trello/*": "allow",
      "bash .opencode/scripts/git-changes/*": "allow",
      "bash .opencode/scripts/task-commits/*": "allow",
      "bash .opencode/scripts/worktree/*": "allow",
      "bash .opencode/scripts/planner/*": "allow",
      "bash .opencode/scripts/check/*": "allow",
      "bash .opencode/scripts/graphify/*": "allow",
      "bash .opencode/scripts/ci/*": "allow",
      "bash .opencode/workflows/*": "allow",
      "bun workflows/*": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow"
    }
  }
}
